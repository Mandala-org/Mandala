#
# File Name
#

System.CurrrentDirectory         ./    # default=./
System.Name                      ZnCuSeS
level.of.stdout                  1    # default=1 (1-3)
level.of.fileout                 1    # default=1 (0-2)

DATA.PATH /bigdata/nanostructures/DFT/DI/forWiktoria/codebase/openmx3.9/DFT_DATA19/

#
# Definition of Atomic Species
#

Species.Number       5
<Definition.of.Atomic.Species
	Zn	Zn10.0S-s2p2d2	Zn_PBE19S
	Cu	Cu10.0S-s2p2d2	Cu_PBE19S
	Sn	Sn7.0-s2p2d3f1	Sn_PBE19
	Se	Se9.0-s4p3d3f2  Se_PBE19
	S	S9.0-s4p3d3f2	S_PBE19
Definition.of.Atomic.Species>

#
# SCF or Electronic System
#

scf.XcType                  GGA-PBE    # LDA|LSDA-CA|LSDA-PW|GGA-PBE
scf.SpinPolarization        off        # On|Off|NC
scf.ElectronicTemperature   300       # default=300 (K)
scf.energycutoff            400.0       # default=150 (Ry)
scf.maxIter                 2000         # default=40
scf.EigenvalueSolver        Band      # DC|GDC|Cluster|Band
scf.Kgrid                  11 11 11       # means 4x4x4
scf.Mixing.Type            Rmm-Diish     # Simple|Rmm-Diis|Gr-Pulay|Kerker|Rmm-Diisk
scf.Init.Mixing.Weight     0.10        # default=0.30
scf.Min.Mixing.Weight      0.01       # default=0.001
scf.Max.Mixing.Weight      0.25       # default=0.40
scf.Mixing.History          32          # default=5
scf.Mixing.StartPulay       16          # default=6
scf.criterion             1.0e-8      # default=1.0e-6 (Hartree)
scf.stress.tensor on # on|off, default=off
#scf.lapack.dste    dstegr

#
# MD or Geometry Optimization
#

MD.Type                      Nomd        # Nomd|Opt|NVE|NVT_VS|NVT_NH
                                         # Constraint_Opt|DIIS2|Constraint_DIIS2
MD.Opt.DIIS.History          4
MD.Opt.StartDIIS             5         # default=5
MD.maxIter                 100         # default=1
MD.TimeStep                1.0         # default=0.5 (fs)
MD.Opt.criterion          1.0e-4       # default=1.0e-4 (Hartree/bohr)

HS.fileout    on


Atoms.Number 32
