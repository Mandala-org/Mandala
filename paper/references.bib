@article{Boron1,
author = {Cao, Erping and Chen, Zhimin and Wu, Hao and Yu, Peng and Wang, Ying and Xiao, Fei and Chen, Shuo and Du, Shichao and Xie, Ying and Wu, Yiqun and Ren, Zhiyu},
title = {Boron-Induced Electronic-Structure Reformation of CoP Nanoparticles Drives Enhanced pH-Universal Hydrogen Evolution},
journal = {Angewandte Chemie International Edition},
volume = {59},
number = {10},
pages = {4154-4160},
keywords = {B-doping, carbon nanotubes (CNTs), electronic structure reformation, hydrogen evolution reaction (HER), transition-metal phosphide catalysts},
doi = {https://doi.org/10.1002/anie.201915254},
url = {https://onlinelibrary.wiley.com/doi/abs/10.1002/anie.201915254},
eprint = {https://onlinelibrary.wiley.com/doi/pdf/10.1002/anie.201915254},
abstract = {Abstract Even though transition-metal phosphides (TMPs) have been developed as promising alternatives to Pt catalyst for the hydrogen evolution reaction (HER), further improvement of their performance requires fine regulation of the TMP sites related to their specific electronic structure. Herein, for the first time, boron (B)-modulated electrocatalytic characteristics in CoP anchored on the carbon nanotubes (B-CoP/CNT) with impressive HER activities over a wide pH range are reported. The HER performance surpasses commercial Pt/C in both neutral and alkaline media at large current density (>100 mA cm−2). A combined experimental and theoretical study identified that the B dopant could reform the local electronic configuration and atomic arrangement of bonded Co and adjacent P atoms, enhance the electrons’ delocalization capacity of Co atoms for high electrical conductivity, and optimize the free energy of H adsorption and H2 desorption on the active sites for better HER kinetics.},
year = {2020}
}

