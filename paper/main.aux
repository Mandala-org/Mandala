\@writefile{toc}{\contentsline {subsection}{\numberline {3.1}Software design goals, sparse data model, and periodic graph construction}{12}{subsection.3.1}\protected@file@percent }
\newlabel{subsec:workflow}{{3.1}{12}{Software design goals, sparse data model, and periodic graph construction}{subsection.3.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Data loading, harmonization, and graph-sample construction in \texttt  {Mandala}. Electronic-structure outputs from OpenMX, FHI-aims, and PySCF are converted by backend-specific parsers into a unified \texttt  {Snapshot} representation containing geometry, periodic-cell information, sparse atom-pair blocks of the Hamiltonian $H$, overlap $S$, and density matrix $D$, and available observable metadata. Snapshot preparation establishes canonical edge ordering, harmonizes backend basis and spherical-harmonic conventions, applies optional distance filtering, and evaluates energy and electron-count targets. Dataset construction is coordinated by \texttt  {DatasetFactory}; shared state provides a global \texttt  {BlockIrrepMapper}, merged orbital metadata, reusable data splits, and snapshot-cache reuse. \texttt  {E3GNNDataset} finally assembles graph-aligned samples with atomic species and positions, periodic edge indices and shifts, edge classes, radial embeddings $\phi (r_{ij})$, and spherical harmonics $Y_{\ell m}(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathbf  r$}\mathaccent "0362{\mathbf  r}_{ij})$. Targets contain sparse matrix blocks or irrep vectors and, when available, band energy and electron count.}}{14}{figure.1}\protected@file@percent }
\newlabel{fig:data_preprocessing}{{1}{14}{Data loading, harmonization, and graph-sample construction in \texttt {Mandala}. Electronic-structure outputs from OpenMX, FHI-aims, and PySCF are converted by backend-specific parsers into a unified \texttt {Snapshot} representation containing geometry, periodic-cell information, sparse atom-pair blocks of the Hamiltonian $H$, overlap $S$, and density matrix $D$, and available observable metadata. Snapshot preparation establishes canonical edge ordering, harmonizes backend basis and spherical-harmonic conventions, applies optional distance filtering, and evaluates energy and electron-count targets. Dataset construction is coordinated by \texttt {DatasetFactory}; shared state provides a global \texttt {BlockIrrepMapper}, merged orbital metadata, reusable data splits, and snapshot-cache reuse. \texttt {E3GNNDataset} finally assembles graph-aligned samples with atomic species and positions, periodic edge indices and shifts, edge classes, radial embeddings $\phi (r_{ij})$, and spherical harmonics $Y_{\ell m}(\widehat {\mathbf r}_{ij})$. Targets contain sparse matrix blocks or irrep vectors and, when available, band energy and electron count}{figure.1}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.2}E(3)-equivariant message passing, readout heads, and architecture variants}{14}{subsection.3.2}\protected@file@percent }
\newlabel{subsec:architecture}{{3.2}{14}{E(3)-equivariant message passing, readout heads, and architecture variants}{subsection.3.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces E(3)-equivariant message-passing architecture and sparse-operator readout. Atomic species, positions, and lattice vectors are transformed into periodic relative displacements, distances, radial features $\phi (r_{ij})$, and real spherical harmonics $Y_{\ell m}(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle \mathbf  r$}\mathaccent "0362{\mathbf  r}_{ij})$. Node and alternative edge encoders initialize irrep-valued latent features. Each repeated \texttt  {MessageBlock} constructs equivariant edge messages from source-node, target-node, edge, radial, and angular features; aggregates the messages to update nodes; and updates edge features, with optional residual and self-connection paths. The implementation supports separate-weight or fully connected tensor products, several equivariant nonlinearities, and extended E(3)-MLP variants. Operator-specific Hamiltonian, overlap, and density heads map the final latent representation to output irreps, with optional tensor-square, scalar, magnitude-factorized, and edge-class-specific branches. The \texttt  {BlockIrrepMapper} then converts the predicted irrep vectors into aligned sparse blocks $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0362{H}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle S$}\mathaccent "0362{S}$, and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}$.}}{18}{figure.2}\protected@file@percent }
\newlabel{fig:model_architecture}{{2}{18}{E(3)-equivariant message-passing architecture and sparse-operator readout. Atomic species, positions, and lattice vectors are transformed into periodic relative displacements, distances, radial features $\phi (r_{ij})$, and real spherical harmonics $Y_{\ell m}(\widehat {\mathbf r}_{ij})$. Node and alternative edge encoders initialize irrep-valued latent features. Each repeated \texttt {MessageBlock} constructs equivariant edge messages from source-node, target-node, edge, radial, and angular features; aggregates the messages to update nodes; and updates edge features, with optional residual and self-connection paths. The implementation supports separate-weight or fully connected tensor products, several equivariant nonlinearities, and extended E(3)-MLP variants. Operator-specific Hamiltonian, overlap, and density heads map the final latent representation to output irreps, with optional tensor-square, scalar, magnitude-factorized, and edge-class-specific branches. The \texttt {BlockIrrepMapper} then converts the predicted irrep vectors into aligned sparse blocks $\widehat H$, $\widehat S$, and $\widehat D$}{figure.2}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.3}Sparse operator algebra, symmetrization, gauge correction, and density normalization}{18}{subsection.3.3}\protected@file@percent }
\newlabel{subsec:postprocessing}{{3.3}{18}{Sparse operator algebra, symmetrization, gauge correction, and density normalization}{subsection.3.3}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Physics-aware postprocessing and electronic-structure analysis of predicted sparse operators. The predicted Hamiltonian $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0362{H}$, overlap $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle S$}\mathaccent "0362{S}$, and density matrix $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}$ are first symmetrized using reverse-edge-aligned sparse blocks. The Hamiltonian branch removes an arbitrary overlap-proportional energy offset through the gauge correction $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0365{H}=H_{\mathrm  {sym}}-\mu _H S_{\mathrm  {sym}}$. The density branch rescales $D_{\mathrm  {sym}}$ to enforce the target electron count through $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0365{D}=N_e D_{\mathrm  {sym}}/\mathrm  {Tr}(D_{\mathrm  {sym}}S_{\mathrm  {sym}})$ and reports the remaining electron-count discrepancy. The corrected Hamiltonian and overlap define the generalized eigenproblem $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0365{H} C=S_{\mathrm  {sym}}C\varepsilon $. The resulting physically processed operators support block-, irrep-, and distance-resolved matrix diagnostics, density-of-states and spectral calculations, and band-structure and related analyses while retaining the sparse representation.}}{20}{figure.3}\protected@file@percent }
\newlabel{fig:postprocessing_analysis}{{3}{20}{Physics-aware postprocessing and electronic-structure analysis of predicted sparse operators. The predicted Hamiltonian $\widehat H$, overlap $\widehat S$, and density matrix $\widehat D$ are first symmetrized using reverse-edge-aligned sparse blocks. The Hamiltonian branch removes an arbitrary overlap-proportional energy offset through the gauge correction $\widetilde H=H_{\mathrm {sym}}-\mu _H S_{\mathrm {sym}}$. The density branch rescales $D_{\mathrm {sym}}$ to enforce the target electron count through $\widetilde D=N_e D_{\mathrm {sym}}/\Tr (D_{\mathrm {sym}}S_{\mathrm {sym}})$ and reports the remaining electron-count discrepancy. The corrected Hamiltonian and overlap define the generalized eigenproblem $\widetilde H C=S_{\mathrm {sym}}C\varepsilon $. The resulting physically processed operators support block-, irrep-, and distance-resolved matrix diagnostics, density-of-states and spectral calculations, and band-structure and related analyses while retaining the sparse representation}{figure.3}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {3.4}Observable guidance with band energies and electron counts}{20}{subsection.3.4}\protected@file@percent }
\newlabel{subsec:training_objectives}{{3.4}{20}{Observable guidance with band energies and electron counts}{subsection.3.4}{}}
\citation{hyperparameterpaper}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Observable-guided training from predicted sparse operators. Reference Hamiltonian, overlap, and density targets, represented as aligned sparse blocks or irrep coefficients, directly supervise the predicted operators $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0362{H}$, $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle S$}\mathaccent "0362{S}$, and $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}$. The same operator set yields the band-energy observable $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle E$}\mathaccent "0362{E}=\mathrm  {Tr}(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}\setbox \z@ \hbox {\mathsurround \z@ $\textstyle H$}\mathaccent "0362{H})$ and electron count $\setbox \z@ \hbox {\mathsurround \z@ $\textstyle N$}\mathaccent "0362{N}_e=\mathrm  {Tr}(\setbox \z@ \hbox {\mathsurround \z@ $\textstyle D$}\mathaccent "0362{D}\setbox \z@ \hbox {\mathsurround \z@ $\textstyle S$}\mathaccent "0362{S})$ through differentiable sparse trace contractions. Experimental force and stress outputs are derivatives of the band energy only and are not total-energy derivatives. All supported matrix and observable terms are combined in a weighted objective. Configuration controls select per-target matrix weights, observable terms, partial-reference traces, density-specific weighting, and training schedules, allowing pure matrix supervision or joint matrix-, band-energy-, and electron-count-guided training without separate observable heads.}}{23}{figure.4}\protected@file@percent }
\newlabel{fig:observable_guidance}{{4}{23}{Observable-guided training from predicted sparse operators. Reference Hamiltonian, overlap, and density targets, represented as aligned sparse blocks or irrep coefficients, directly supervise the predicted operators $\widehat H$, $\widehat S$, and $\widehat D$. The same operator set yields the band-energy observable $\widehat E=\Tr (\widehat D\widehat H)$ and electron count $\widehat N_e=\Tr (\widehat D\widehat S)$ through differentiable sparse trace contractions. Experimental force and stress outputs are derivatives of the band energy only and are not total-energy derivatives. All supported matrix and observable terms are combined in a weighted objective. Configuration controls select per-target matrix weights, observable terms, partial-reference traces, density-specific weighting, and training schedules, allowing pure matrix supervision or joint matrix-, band-energy-, and electron-count-guided training without separate observable heads}{figure.4}{}}
